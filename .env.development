# Local development. The admin talks to the bplay-backend (DB on host 5433, API on 3000).
# LAN IP rather than localhost so the dashboard also works when opened from
# another device on the same Wi-Fi (a phone, a second laptop).
#VITE_API_BASE_URL=http://10.203.24.216:3000/api/v1
# Live: every feature talks to the real bplay-backend.
# Auth and Owner Management are wired end-to-end; the features whose backend
# modules do not exist yet (dashboard, community, chat, feedback, notifications,
# audit, bookings, club subscriptions, plans, regions) will surface a load error
# instead of mock data until their endpoints land.
# Flip back to `true` — or run `npm run build:demo`, which uses .env.demo — for a
# backend-free demo.
#VITE_USE_MOCKS=false
